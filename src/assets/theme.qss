QMainWindow {
    background: #111318;
}

QToolBar#navigationBar {
    background: #181b21;
    border: none;
    border-bottom: 1px solid #292e37;
    spacing: 5px;
    padding: 8px 10px;
}

QToolBar#navigationBar QToolButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    padding: 0;
}

QToolBar#navigationBar QToolButton:hover {
    background: #292e37;
}

QToolBar#navigationBar QToolButton:pressed {
    background: #343b47;
}

QToolBar#navigationBar QToolButton:disabled {
    background: transparent;
    opacity: 0.35;
}

QLineEdit#addressBar {
    min-height: 34px;
    background: #22262e;
    color: #edf0f6;
    border: 1px solid #343a45;
    border-radius: 9px;
    padding: 0 11px;
    selection-background-color: #3d72d9;
}

QLineEdit#addressBar:hover {
    border-color: #454d5c;
}

QLineEdit#addressBar:focus {
    background: #242932;
    border: 1px solid #5b8def;
}

QStatusBar {
    min-height: 31px;
    background: #15181e;
    color: #aeb5c2;
    border-top: 1px solid #292e37;
}

QStatusBar::item {
    border: none;
}

QLabel#trustStatus {
    color: #b9c0cc;
    border-radius: 7px;
    padding: 4px 9px;
    margin: 3px 5px;
}

QLabel#trustStatus[state="secure"] {
    color: #8ce0b4;
    background: rgba(52, 211, 153, 0.10);
}

QLabel#trustStatus[state="error"] {
    color: #fb8b9c;
    background: rgba(251, 113, 133, 0.10);
}

QLabel#trustStatus[state="neutral"] {
    color: #aeb5c2;
    background: transparent;
}

QLabel#ruleCount {
    color: #87909f;
    background: #20242b;
    border-radius: 7px;
    padding: 4px 9px;
    margin: 3px 7px 3px 4px;
}

QProgressBar#pageProgress {
    min-width: 100px;
    max-width: 100px;
    min-height: 3px;
    max-height: 3px;
    background: #292e37;
    border: none;
    border-radius: 1px;
    margin-right: 7px;
}

QProgressBar#pageProgress::chunk {
    background: #5b8def;
    border-radius: 1px;
}

QMenuBar {
    background: #181b21;
    color: #d8dce5;
}

QMenu {
    background: #20242b;
    color: #e3e6ec;
    border: 1px solid #343a45;
    padding: 6px;
}

QMenu::item {
    border-radius: 6px;
    padding: 7px 26px 7px 10px;
}

QMenu::item:selected {
    background: #315ea8;
}
