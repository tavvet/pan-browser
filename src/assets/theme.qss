QMainWindow {
    background: #111318;
}

QToolBar#tabsBar {
    background: #15181e;
    border: none;
    border-bottom: 1px solid #292e37;
    spacing: 6px;
    padding: 5px 8px 0 8px;
}

QTabBar#browserTabBar {
    background: transparent;
}

QTabBar#browserTabBar::tab {
    min-width: 130px;
    max-width: 230px;
    min-height: 31px;
    color: #929baa;
    background: #1b1f26;
    border: 1px solid #292e37;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 0 28px 0 11px;
    margin-right: 3px;
}

QTabBar#browserTabBar::tab:hover:!selected {
    color: #d7dce5;
    background: #20242c;
}

QTabBar#browserTabBar::tab:selected {
    color: #edf0f6;
    background: #252a33;
    border-color: #3a414d;
}

QTabBar#browserTabBar::close-button {
    image: url(:/assets/icons/x.svg);
    subcontrol-position: right;
    width: 14px;
    height: 14px;
    margin-right: 8px;
}

QToolBar#tabsBar QToolButton#newTabButton {
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    margin-bottom: 1px;
    background: transparent;
    border: none;
    border-radius: 7px;
}

QToolBar#tabsBar QToolButton#newTabButton:hover {
    background: #292e37;
}

QToolBar#tabsBar QToolButton#newTabButton:pressed {
    background: #343b47;
}

QToolBar#navigationBar {
    background: #181b21;
    border: none;
    border-bottom: 1px solid #292e37;
    spacing: 5px;
    padding: 8px 10px;
}

QToolBar#navigationBar > QToolButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    padding: 0;
}

QToolBar#navigationBar > QToolButton:hover {
    background: #292e37;
}

QToolBar#navigationBar > QToolButton:pressed {
    background: #343b47;
}

QToolBar#navigationBar > QToolButton:disabled {
    background: transparent;
    opacity: 0.35;
}

QToolBar#permissionBar {
    background: #181b21;
    border: none;
    border-bottom: 1px solid #343a45;
    padding: 0;
}

QToolBar#findBar {
    background: #181b21;
    border: none;
    border-bottom: 1px solid #343a45;
    padding: 0;
}

QWidget#findBarContent {
    background: #181b21;
}

QLabel#findLabel {
    color: #c5cbd5;
    font-weight: 600;
}

QLineEdit#findInput {
    min-height: 31px;
    max-width: 520px;
    color: #edf0f6;
    background: #22262e;
    border: 1px solid #343a45;
    border-radius: 8px;
    padding: 0 9px;
    selection-background-color: #3d72d9;
}

QLineEdit#findInput:focus {
    background: #242932;
    border-color: #5b8def;
}

QLabel#findResult {
    color: #929baa;
}

QWidget#findBarContent QToolButton {
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 0;
}

QWidget#findBarContent QToolButton:hover {
    background: #292e37;
}

QWidget#findBarContent QToolButton:pressed {
    background: #343b47;
}

QWidget#findBarContent QToolButton:disabled {
    background: transparent;
    opacity: 0.35;
}

QWidget#permissionPrompt {
    background: #20242c;
}

QLabel#permissionTitle {
    color: #f3f5f9;
    font-weight: 600;
}

QLabel#permissionDescription {
    color: #aeb6c3;
}

QWidget#permissionPrompt QPushButton {
    min-height: 29px;
    color: #e9edf5;
    background: #2b313b;
    border: 1px solid #3b4350;
    border-radius: 7px;
    padding: 2px 14px;
}

QWidget#permissionPrompt QPushButton:hover {
    background: #353d49;
    border-color: #4a5665;
}

QWidget#permissionPrompt QPushButton#permissionAllow {
    color: #ffffff;
    background: #3d72d9;
    border-color: #5689ea;
}

QWidget#permissionPrompt QPushButton#permissionAllow:hover {
    background: #487fe6;
}

QLineEdit#addressBar {
    min-height: 34px;
    background: #22262e;
    color: #edf0f6;
    border: 1px solid #343a45;
    border-radius: 9px;
    padding: 0 11px;
    selection-background-color: #3d72d9;
}

QLineEdit#addressBar:hover {
    border-color: #454d5c;
}

QLineEdit#addressBar:focus {
    background: #242932;
    border: 1px solid #5b8def;
}

QLineEdit#addressBar[completionPlacement="below"] {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

QLineEdit#addressBar[completionPlacement="above"] {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

QLineEdit#addressBar QToolButton {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 5px;
}

QLineEdit#addressBar QToolButton:hover {
    background: #343a45;
}

QFrame#addressCompletionPopup {
    background: #181b21;
    border: 1px solid #3a414d;
    border-radius: 0;
}

QFrame#addressCompletionPopup[placement="below"] {
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

QFrame#addressCompletionPopup[placement="above"] {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QListWidget#addressCompletionList {
    background: transparent;
    color: #e7eaf0;
    border: none;
    outline: none;
    padding: 0;
}

QListWidget#addressCompletionList::item {
    border-radius: 7px;
    padding: 4px 10px;
}

QListWidget#addressCompletionList::item:hover,
QListWidget#addressCompletionList::item:selected {
    color: #ffffff;
    background: #315ea8;
}

QStatusBar {
    min-height: 31px;
    background: #15181e;
    color: #aeb5c2;
    border-top: 1px solid #292e37;
}

QStatusBar::item {
    border: none;
}

QLabel#trustStatus {
    color: #b9c0cc;
    border-radius: 7px;
    padding: 4px 9px;
    margin: 3px 5px;
}

QLabel#trustStatus[state="secure"] {
    color: #8ce0b4;
    background: rgba(52, 211, 153, 0.10);
}

QLabel#trustStatus[state="error"] {
    color: #fb8b9c;
    background: rgba(251, 113, 133, 0.10);
}

QLabel#trustStatus[state="neutral"] {
    color: #aeb5c2;
    background: transparent;
}

QLabel#ruleCount {
    color: #87909f;
    background: #20242b;
    border-radius: 7px;
    padding: 4px 9px;
    margin: 3px 7px 3px 4px;
}

QProgressBar#pageProgress {
    min-width: 100px;
    max-width: 100px;
    min-height: 3px;
    max-height: 3px;
    background: #292e37;
    border: none;
    border-radius: 1px;
    margin-right: 7px;
}

QProgressBar#pageProgress::chunk {
    background: #5b8def;
    border-radius: 1px;
}

QMenuBar {
    background: #181b21;
    color: #d8dce5;
}

QMenu {
    background: #20242b;
    color: #e3e6ec;
    border: 1px solid #343a45;
    padding: 6px;
}

QMenu::item {
    border-radius: 6px;
    padding: 7px 26px 7px 10px;
}

QMenu::item:selected {
    background: #315ea8;
}

QDialog#settingsDialog {
    background: #15181e;
    color: #e6e9ef;
}

QDialog#settingsDialog QListWidget#settingsSidebar {
    background: #111318;
    color: #b7beca;
    border: none;
    border-right: 1px solid #292e37;
    border-radius: 0;
    outline: none;
    padding: 18px 10px;
}

QDialog#settingsDialog QListWidget#settingsSidebar::item {
    min-height: 38px;
    border-radius: 8px;
    padding: 4px 9px;
    margin-bottom: 3px;
}

QDialog#settingsDialog QListWidget#settingsSidebar::item:hover {
    color: #edf0f6;
    background: #20242b;
}

QDialog#settingsDialog QListWidget#settingsSidebar::item:selected {
    color: #ffffff;
    background: #315ea8;
}

QDialog#settingsDialog QWidget#generalSettingsPage,
QDialog#settingsDialog QWidget#searchSettingsPage,
QDialog#settingsDialog QWidget#historySettingsPage,
QDialog#settingsDialog QWidget#webAppsSettingsPage,
QDialog#settingsDialog QWidget#diagnosticsSettingsPage,
QDialog#settingsDialog QScrollArea#diagnosticsScroll,
QDialog#settingsDialog QWidget#diagnosticsContent,
QDialog#settingsDialog QWidget#privacyDataSettingsPage,
QDialog#settingsDialog QStackedWidget#settingsPages {
    background: #15181e;
}

QDialog#settingsDialog QLabel {
    color: #dce1e9;
}

QDialog#settingsDialog QLabel#dialogTitle {
    color: #f5f7fb;
    font-size: 22px;
    font-weight: 700;
}

QDialog#settingsDialog QLabel#dialogSubtitle,
QDialog#settingsDialog QLabel#fieldHint {
    color: #929baa;
}

QDialog#settingsDialog QLabel#sectionLabel {
    color: #778295;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QDialog#settingsDialog QFrame#settingsCard {
    background: #1b1f26;
    border: 1px solid #303641;
    border-radius: 10px;
}

QDialog#settingsDialog QLabel#settingsCardTitle {
    color: #edf0f6;
    font-size: 14px;
    font-weight: 600;
}

QDialog#settingsDialog QLabel#dataActionStatus {
    color: #8ce0b4;
}

QDialog#settingsDialog QLabel#diagnosticValue {
    color: #dce1e9;
}

QDialog#settingsDialog QFrame#settingsSeparator {
    color: #292e37;
    background: #292e37;
    border: none;
    max-height: 1px;
}

QDialog#settingsDialog QLineEdit,
QDialog#settingsDialog QComboBox {
    min-height: 30px;
    background: #20242c;
    color: #edf0f6;
    border: 1px solid #373e4a;
    border-radius: 7px;
    padding: 2px 9px;
    selection-background-color: #3d72d9;
}

QDialog#settingsDialog QLineEdit:focus,
QDialog#settingsDialog QComboBox:focus {
    border-color: #5b8def;
}

QDialog#settingsDialog QComboBox::drop-down {
    width: 28px;
    border: none;
}

QDialog#settingsDialog QComboBox::down-arrow {
    image: url(:/assets/icons/chevron-down.svg);
    width: 12px;
    height: 12px;
}

QDialog#settingsDialog QComboBox QAbstractItemView {
    background: #20242c;
    color: #edf0f6;
    border: 1px solid #373e4a;
    outline: none;
    selection-background-color: #315ea8;
    selection-color: #ffffff;
}

QDialog#settingsDialog QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 3px 8px;
}

QDialog#settingsDialog QCheckBox {
    color: #dce1e9;
    spacing: 8px;
}

QDialog#settingsDialog QPushButton {
    min-height: 30px;
    color: #e9edf5;
    background: #2a303a;
    border: 1px solid #3a424f;
    border-radius: 7px;
    padding: 2px 13px;
}

QDialog#settingsDialog QPushButton:hover {
    background: #343c48;
    border-color: #4a5564;
}

QDialog#settingsDialog QPushButton:default {
    background: #3d72d9;
    border-color: #5689ea;
    color: #ffffff;
}

QDialog#settingsDialog QPushButton#dangerButton {
    color: #ff9aaa;
}

QDialog#settingsDialog QListWidget#searchEnginesList,
QDialog#settingsDialog QListWidget#webAppsList {
    background: #1b1f26;
    color: #e3e7ee;
    border: 1px solid #303641;
    border-radius: 9px;
    outline: none;
    padding: 4px;
}

QDialog#settingsDialog QListWidget#historyVisits {
    background: #1b1f26;
    color: #e3e7ee;
    border: 1px solid #303641;
    border-radius: 9px;
    outline: none;
    padding: 4px;
}

QDialog#settingsDialog QListWidget#historyVisits::item {
    border-radius: 7px;
    padding: 4px 8px;
}

QDialog#settingsDialog QListWidget#historyVisits::item:disabled {
    min-height: 25px;
    color: #778295;
    background: transparent;
    font-size: 11px;
    font-weight: 700;
}

QDialog#settingsDialog QListWidget#historyVisits::item:hover:!disabled {
    background: #262c35;
}

QDialog#settingsDialog QListWidget#historyVisits::item:selected {
    color: #ffffff;
    background: #315ea8;
}

QDialog#settingsDialog QListWidget#searchEnginesList::item {
    min-height: 34px;
    border-radius: 7px;
    padding: 4px 8px;
}

QDialog#settingsDialog QListWidget#webAppsList::item {
    min-height: 46px;
    border-radius: 7px;
    padding: 5px 8px;
}

QDialog#settingsDialog QListWidget#searchEnginesList::item:hover,
QDialog#settingsDialog QListWidget#webAppsList::item:hover {
    background: #262c35;
}

QDialog#settingsDialog QListWidget#searchEnginesList::item:selected,
QDialog#settingsDialog QListWidget#webAppsList::item:selected {
    background: #315ea8;
    color: #ffffff;
}

QDialog#searchEngineDialog {
    background: #15181e;
    color: #e6e9ef;
}

QDialog#searchEngineDialog QLabel#dialogTitle {
    color: #f5f7fb;
    font-size: 22px;
    font-weight: 700;
}

QDialog#searchEngineDialog QLabel#fieldHint {
    color: #929baa;
}

QDialog#searchEngineDialog QLineEdit {
    min-height: 30px;
    background: #20242c;
    color: #edf0f6;
    border: 1px solid #373e4a;
    border-radius: 7px;
    padding: 2px 9px;
    selection-background-color: #3d72d9;
}

QDialog#searchEngineDialog QLineEdit:focus {
    border-color: #5b8def;
}

QDialog#searchEngineDialog QPushButton {
    min-height: 30px;
    color: #e9edf5;
    background: #2a303a;
    border: 1px solid #3a424f;
    border-radius: 7px;
    padding: 2px 13px;
}

QDialog#searchEngineDialog QPushButton:default {
    background: #3d72d9;
    border-color: #5689ea;
    color: #ffffff;
}

QDialog#trustRulesDialog {
    background: #15181e;
    color: #e6e9ef;
}

QDialog#trustRulesDialog QLabel#dialogTitle {
    color: #f5f7fb;
    font-size: 22px;
    font-weight: 700;
}

QDialog#trustRulesDialog QLabel#dialogSubtitle,
QDialog#trustRulesDialog QLabel#fieldHint {
    color: #929baa;
}

QDialog#trustRulesDialog QLabel#sectionLabel {
    color: #778295;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QDialog#trustRulesDialog QSplitter::handle {
    background: #292e37;
    width: 1px;
}

QDialog#trustRulesDialog QScrollArea#ruleEditorScroll,
QDialog#trustRulesDialog QWidget#ruleEditor,
QDialog#trustRulesDialog QScrollArea#ruleEditorScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

QDialog#trustRulesDialog QListWidget {
    background: #1b1f26;
    color: #e3e7ee;
    border: 1px solid #303641;
    border-radius: 9px;
    outline: none;
    padding: 4px;
}

QDialog#trustRulesDialog QListWidget::item {
    border-radius: 7px;
    padding: 7px 8px;
}

QDialog#trustRulesDialog QListWidget::item:hover {
    background: #262c35;
}

QDialog#trustRulesDialog QListWidget::item:selected {
    background: #315ea8;
    color: #ffffff;
}

QDialog#trustRulesDialog QLineEdit,
QDialog#trustRulesDialog QPlainTextEdit,
QDialog#trustRulesDialog QComboBox {
    background: #20242c;
    color: #edf0f6;
    border: 1px solid #373e4a;
    border-radius: 7px;
    padding: 7px 9px;
    selection-background-color: #3d72d9;
}

QDialog#trustRulesDialog QLineEdit:focus,
QDialog#trustRulesDialog QPlainTextEdit:focus,
QDialog#trustRulesDialog QComboBox:focus {
    border-color: #5b8def;
}

QDialog#trustRulesDialog QComboBox::drop-down {
    border: none;
    width: 24px;
}

QDialog#trustRulesDialog QComboBox QAbstractItemView {
    background: #20242c;
    color: #edf0f6;
    border: 1px solid #373e4a;
    selection-background-color: #315ea8;
}

QDialog#trustRulesDialog QCheckBox {
    color: #dce1e9;
    spacing: 8px;
}

QDialog#trustRulesDialog QPushButton {
    min-height: 30px;
    color: #e9edf5;
    background: #2a303a;
    border: 1px solid #3a424f;
    border-radius: 7px;
    padding: 2px 13px;
}

QDialog#trustRulesDialog QPushButton:hover {
    background: #343c48;
    border-color: #4a5564;
}

QDialog#trustRulesDialog QPushButton:pressed {
    background: #242a33;
}

QDialog#trustRulesDialog QPushButton:default {
    background: #3d72d9;
    border-color: #5689ea;
    color: #ffffff;
}

QDialog#trustRulesDialog QPushButton:default:hover {
    background: #477fe8;
}

QDialog#trustRulesDialog QPushButton#dangerButton {
    color: #ff9aaa;
}

QDialog#trustRulesDialog QPushButton:disabled,
QDialog#trustRulesDialog QLineEdit:disabled,
QDialog#trustRulesDialog QPlainTextEdit:disabled,
QDialog#trustRulesDialog QComboBox:disabled {
    color: #626b79;
    background: #1b1e24;
    border-color: #292e37;
}

QDialog#trustRulesDialog QLabel#testResult {
    border-radius: 7px;
    padding: 7px 9px;
}

QDialog#trustRulesDialog QLabel#testResult[state="match"] {
    color: #8ce0b4;
    background: rgba(52, 211, 153, 0.10);
}

QDialog#trustRulesDialog QLabel#testResult[state="none"] {
    color: #f4c783;
    background: rgba(245, 158, 11, 0.10);
}

QDialog#certificateDetailsDialog {
    background: #15181e;
    color: #dce1e9;
}

QDialog#certificateDetailsDialog QLabel#dialogTitle {
    color: #f5f7fb;
    font-size: 22px;
    font-weight: 700;
}

QDialog#openSourceNoticesDialog,
QDialog#chromiumCreditsDialog {
    background: #15181e;
}

QDialog#openSourceNoticesDialog QLabel#dialogTitle {
    color: #f5f7fb;
    font-size: 22px;
    font-weight: 700;
}

QDialog#openSourceNoticesDialog QLabel#dialogSubtitle,
QDialog#openSourceNoticesDialog QLabel#fieldHint,
QDialog#chromiumCreditsDialog QLabel#dialogSubtitle {
    color: #929baa;
}

QDialog#openSourceNoticesDialog QListWidget#noticeFiles,
QDialog#openSourceNoticesDialog QPlainTextEdit#noticeText {
    background: #1b1f26;
    color: #dce1e9;
    border: 1px solid #303641;
    border-radius: 8px;
}

QDialog#openSourceNoticesDialog QListWidget#noticeFiles::item {
    padding: 6px 8px;
}

QDialog#openSourceNoticesDialog QListWidget#noticeFiles::item:selected {
    color: #ffffff;
    background: #315ea8;
}

QDialog#certificateDetailsDialog QLabel#dialogSubtitle {
    color: #929baa;
}

QDialog#certificateDetailsDialog QLabel#certificateValue {
    color: #edf0f6;
}

QDialog#certificateDetailsDialog QLabel#certificateFingerprint {
    color: #b8ccff;
    background: #20242c;
    border: 1px solid #343b47;
    border-radius: 7px;
    padding: 7px 9px;
    font-family: "SF Mono", Menlo, monospace;
}

QDialog#certificateDetailsDialog QLabel#certificateStatus {
    border-radius: 7px;
    padding: 7px 10px;
    font-weight: 600;
}

QDialog#certificateDetailsDialog QLabel#certificateStatus[state="valid"] {
    color: #8ce0b4;
    background: rgba(52, 211, 153, 0.10);
}

QDialog#certificateDetailsDialog QLabel#certificateStatus[state="warning"] {
    color: #f4c783;
    background: rgba(245, 158, 11, 0.10);
}

QDialog#certificateDetailsDialog QLabel#certificateStatus[state="error"] {
    color: #fb8b9c;
    background: rgba(251, 113, 133, 0.10);
}

QDialog#certificateDetailsDialog QComboBox {
    background: #20242c;
    color: #edf0f6;
    border: 1px solid #373e4a;
    border-radius: 7px;
    padding: 7px 9px;
}

QDialog#certificateDetailsDialog QPushButton {
    min-height: 30px;
    color: #e9edf5;
    background: #2a303a;
    border: 1px solid #3a424f;
    border-radius: 7px;
    padding: 2px 13px;
}

QDialog#certificateDetailsDialog QPushButton:hover {
    background: #343c48;
    border-color: #4a5564;
}

QDialog#downloadsPanel {
    background: #171a20;
    color: #e6e9ef;
    border: 1px solid #343a45;
    border-radius: 11px;
}

QDialog#downloadsPanel QLabel#downloadsTitle {
    color: #f5f7fb;
    font-size: 18px;
    font-weight: 700;
}

QDialog#downloadsPanel QFrame#downloadsSeparator {
    color: #303641;
    background: #303641;
    border: none;
    max-height: 1px;
}

QDialog#downloadsPanel QScrollArea#downloadsScroll,
QDialog#downloadsPanel QWidget#downloadsItems,
QDialog#downloadsPanel QScrollArea#downloadsScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

QDialog#downloadsPanel QFrame#downloadItem {
    background: #1f232b;
    border: 1px solid #303641;
    border-radius: 9px;
}

QDialog#downloadsPanel QLabel#downloadName {
    color: #edf0f6;
    font-weight: 600;
}

QDialog#downloadsPanel QLabel#downloadDetails,
QDialog#downloadsPanel QLabel#downloadsEmpty {
    color: #929baa;
}

QDialog#downloadsPanel QProgressBar#downloadProgress {
    min-height: 4px;
    max-height: 4px;
    background: #303641;
    border: none;
    border-radius: 2px;
}

QDialog#downloadsPanel QProgressBar#downloadProgress::chunk {
    background: #5b8def;
    border-radius: 2px;
}

QDialog#downloadsPanel QPushButton {
    min-height: 27px;
    color: #e9edf5;
    background: #2a303a;
    border: 1px solid #3a424f;
    border-radius: 6px;
    padding: 1px 10px;
}

QDialog#downloadsPanel QPushButton:hover {
    background: #343c48;
    border-color: #4a5564;
}

QDialog#downloadsPanel QPushButton#subtleButton {
    color: #aeb5c2;
    background: transparent;
    border-color: transparent;
}

QDialog#downloadsPanel QPushButton#subtleButton:hover {
    color: #edf0f6;
    background: #292e37;
}

QDialog#bookmarkDialog,
QDialog#bookmarksDialog {
    background: #15181e;
    color: #dce1e9;
}

QDialog#bookmarkDialog QLabel#dialogTitle,
QDialog#bookmarksDialog QLabel#dialogTitle {
    color: #f5f7fb;
    font-size: 22px;
    font-weight: 700;
}

QDialog#bookmarksDialog QLabel#dialogSubtitle,
QDialog#bookmarksDialog QLabel#fieldHint {
    color: #929baa;
}

QDialog#bookmarkDialog QLineEdit,
QDialog#bookmarksDialog QLineEdit {
    min-height: 34px;
    color: #edf0f6;
    background: #20242c;
    border: 1px solid #373e4a;
    border-radius: 8px;
    padding: 0 10px;
    selection-background-color: #3d72d9;
}

QDialog#bookmarkDialog QLineEdit:focus,
QDialog#bookmarksDialog QLineEdit:focus {
    border-color: #5b8def;
    background: #242932;
}

QDialog#bookmarksDialog QListWidget#bookmarksList {
    color: #dce1e9;
    background: #181b21;
    border: 1px solid #303641;
    border-radius: 9px;
    outline: none;
    padding: 4px;
}

QDialog#bookmarksDialog QListWidget#bookmarksList::item {
    border-radius: 7px;
    padding: 6px 9px;
}

QDialog#bookmarksDialog QListWidget#bookmarksList::item:hover {
    background: #252a33;
}

QDialog#bookmarksDialog QListWidget#bookmarksList::item:selected {
    color: #ffffff;
    background: #315ea8;
}

QDialog#bookmarkDialog QPushButton,
QDialog#bookmarksDialog QPushButton {
    min-height: 30px;
    color: #e9edf5;
    background: #2a303a;
    border: 1px solid #3a424f;
    border-radius: 7px;
    padding: 2px 13px;
}

QDialog#bookmarkDialog QPushButton:hover,
QDialog#bookmarksDialog QPushButton:hover {
    background: #343c48;
    border-color: #4a5564;
}

QDialog#bookmarkDialog QPushButton:default,
QDialog#bookmarksDialog QPushButton:default {
    color: #ffffff;
    background: #3d72d9;
    border-color: #5689ea;
}

QDialog#bookmarkDialog QPushButton#dangerButton,
QDialog#bookmarksDialog QPushButton#dangerButton {
    color: #ff9aaa;
}

QDialog#bookmarkDialog QPushButton:disabled,
QDialog#bookmarksDialog QPushButton:disabled {
    color: #626b79;
    background: #1b1e24;
    border-color: #292e37;
}

QDialog#httpAuthenticationDialog,
QDialog#proxyAuthenticationDialog {
    background: #15181e;
    color: #dce1e9;
}

QDialog#httpAuthenticationDialog QLabel#dialogTitle,
QDialog#proxyAuthenticationDialog QLabel#dialogTitle {
    color: #f5f7fb;
    font-size: 22px;
    font-weight: 700;
}

QDialog#httpAuthenticationDialog QLabel#fieldHint,
QDialog#proxyAuthenticationDialog QLabel#fieldHint {
    color: #929baa;
}

QDialog#httpAuthenticationDialog QLabel#errorText,
QDialog#proxyAuthenticationDialog QLabel#errorText {
    color: #ff9aaa;
}

QDialog#httpAuthenticationDialog QLabel#insecureTransportWarning {
    color: #ffd38a;
    background: #332818;
    border: 1px solid #66502b;
    border-radius: 7px;
    padding: 8px 10px;
}

QDialog#httpAuthenticationDialog QLineEdit,
QDialog#proxyAuthenticationDialog QLineEdit {
    min-height: 34px;
    color: #edf0f6;
    background: #20242c;
    border: 1px solid #373e4a;
    border-radius: 8px;
    padding: 0 10px;
    selection-background-color: #3d72d9;
}

QDialog#httpAuthenticationDialog QLineEdit:focus,
QDialog#proxyAuthenticationDialog QLineEdit:focus {
    border-color: #5b8def;
    background: #242932;
}

QDialog#httpAuthenticationDialog QPushButton,
QDialog#proxyAuthenticationDialog QPushButton {
    min-height: 30px;
    color: #e9edf5;
    background: #2a303a;
    border: 1px solid #3a424f;
    border-radius: 7px;
    padding: 2px 13px;
}

QDialog#httpAuthenticationDialog QPushButton:hover,
QDialog#proxyAuthenticationDialog QPushButton:hover {
    background: #343c48;
    border-color: #4a5564;
}

QDialog#httpAuthenticationDialog QPushButton:default,
QDialog#proxyAuthenticationDialog QPushButton:default {
    color: #ffffff;
    background: #3d72d9;
    border-color: #5689ea;
}

QMainWindow#detachedVideoWindow {
    background: #000000;
}

QFrame#detachedVideoOriginBar {
    background: #151a23;
    border: none;
    border-bottom: 1px solid #313a49;
}

QLabel#detachedVideoOriginCaption,
QLabel#detachedVideoOrigin {
    color: #b9c3d2;
    font-size: 12px;
    font-weight: 600;
}

QFrame#detachedVideoPlaceholder {
    background: #111318;
    border: none;
}

QLabel#detachedVideoMessage {
    color: #c5cbd5;
    font-size: 16px;
    font-weight: 600;
}

QPushButton#returnDetachedVideoButton {
    min-height: 32px;
    color: #ffffff;
    background: #3d72d9;
    border: 1px solid #5689ea;
    border-radius: 8px;
    padding: 2px 16px;
}

QPushButton#returnDetachedVideoButton:hover {
    background: #487fe6;
}
